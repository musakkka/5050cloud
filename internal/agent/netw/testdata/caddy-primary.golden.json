        "writer": {
          "output": "stderr"
        }
      },
      "fifty": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.fifty"
        ],
        "writer": {
          "filename": "/var/lib/5050/caddy/logs/access.log",
          "output": "file",
          "roll_keep": 2,
          "roll_keep_days": 2,
          "roll_size_mb": 100
        }
      },
      "tlslog": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "tls"
