#
# mongod configuration rendered by 5050cloud at each deploy. The WiredTiger
# cache follows the service's memory limit (half of the limit minus 1 GB, at
# least 0.25 GB), or the host's memory when the service has no limit.
net:
  port: 27017
  bindIpAll: true
storage:
  dbPath: /data/db
  wiredTiger:
    engineConfig:
      cacheSizeGB: {{ .Mongo.CacheSizeGB }}
