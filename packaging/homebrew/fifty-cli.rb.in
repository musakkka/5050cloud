# SPDX-License-Identifier: MIT
#
# Homebrew formula for the 5050 CLI. Generated by
# packaging/homebrew/update-tap.sh from packaging/homebrew/fifty-cli.rb.in in
# the 5050cloud repository; edit the template there, not this file.
#
# The formula is named fifty-cli because a Homebrew formula name becomes a
# Ruby class name, which cannot start with a digit. The tap also carries the
# alias 5050, so `brew install musakkka/tap/5050` works too.
class FiftyCli < Formula
  desc "Command-line client for 5050cloud, the self-hosted app platform"
  homepage "https://5050cloud.com"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "@URL_BASE@/v#{version}/5050-cli_#{version}_darwin_arm64.tar.gz"
      sha256 "@SHA256_DARWIN_ARM64@"
    end
    on_intel do
      url "@URL_BASE@/v#{version}/5050-cli_#{version}_darwin_amd64.tar.gz"
      sha256 "@SHA256_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "@URL_BASE@/v#{version}/5050-cli_#{version}_linux_arm64.tar.gz"
      sha256 "@SHA256_LINUX_ARM64@"
    end
    on_intel do
      url "@URL_BASE@/v#{version}/5050-cli_#{version}_linux_amd64.tar.gz"
      sha256 "@SHA256_LINUX_AMD64@"
    end
  end

  def install
    bin.install "5050"
    generate_completions_from_executable(bin/"5050", "completion")
  end

  def caveats
    <<~EOS
      Log in to your install with:
        5050 login https://<your console>

      To run Railway CLI commands against 5050cloud, add the railway alias:
        ln -s "#{opt_bin}/5050" "#{HOMEBREW_PREFIX}/bin/railway"
    EOS
  end

  test do
    ENV["FIFTY_CONFIG"] = testpath/"config.json"
    assert_match "v#{version}", shell_output("#{bin}/5050 version")
    assert_match "5050", shell_output("#{bin}/5050 completion bash")
  end
end
