# SPDX-License-Identifier: MIT
[Unit]
Description=5050cloud firewall and mesh restore (before Docker)
DefaultDependencies=no
After=network-pre.target local-fs.target
Before=docker.service
ConditionPathExists=/etc/5050/agent.json

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/5050/agent/5050-agent net-restore

[Install]
WantedBy=multi-user.target
